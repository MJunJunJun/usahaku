# Docker Compose: use a URL with URL-encoded username/password.
MONGO_ROOT_USERNAME=change-me
MONGO_ROOT_PASSWORD=generate-a-long-random-password
MONGO_URL=mongodb://change-me:generate-a-long-random-password@mongo:27017/usahaku?authSource=admin
DB_NAME=usahaku
JWT_SECRET=generate-a-64-byte-random-secret
# Optional one-time administrator bootstrap. Set both, use at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOWA_USER=change-me
GOWA_PASS=generate-a-long-random-password
WHATSAPP_WEBHOOK_SECRET=generate-a-long-random-secret
# Required by docker-compose for administrator two-factor authentication.
# Store this only in an authenticator/password manager, never in Git.
ADMIN_TOTP_SECRET=generate-a-base32-totp-secret
APP_NAME=Situska
SUPPORT_EMAIL=hello@usahaku.id
PUBLIC_APP_URL=https://situska.com

# Auth & domain. Biarkan COOKIE_DOMAIN kosong agar otomatis mengikuti domain aktif.
# Untuk frontend/backend beda domain: COOKIE_SAMESITE=none dan COOKIE_SECURE=true.
AUTH_COOKIE_DAYS=30
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=auto

# Kosongkan jika frontend dan API dilayani dari domain yang sama melalui /api.
# Jika terpisah, isi origin frontend dipisahkan koma, tanpa slash terakhir.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Arahkan ke volume/folder persisten di server production.
UPLOAD_DIR=./uploads
