# Situska Backend Environment
# Copy to backend/.env or set via docker-compose env vars.

# MongoDB (no auth — internal Docker network only)
MONGO_URL=mongodb://mongo:27017
DB_NAME=usahaku

# Security
JWT_SECRET=generate-a-64-byte-random-secret
TURNSTILE_SECRET_KEY=copy-the-secret-key-from-cloudflare-turnstile

# Admin bootstrap
ADMIN_EMAIL=admin@usahaku.id
ADMIN_PASSWORD=generate-a-strong-password

# TOTP for admin MFA
ADMIN_TOTP_SECRET=generate-a-totp-secret

# Domain
COOKIE_DOMAIN=.situska.com
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
PUBLIC_SITE_DOMAIN=situska.com
PUBLIC_APP_URL=https://situska.com

# WhatsApp Gateway
GOWA_USER=admin
GOWA_PASS=generate-a-strong-password
WHATSAPP_WEBHOOK_SECRET=generate-a-random-secret

# App
APP_NAME=Situska
SUPPORT_EMAIL=hello@usahaku.id
